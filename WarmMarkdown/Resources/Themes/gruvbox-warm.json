{
  "name": "Gruvbox Warm",
  "type": "dark",
  "colors": {
    "editor.background": "#282828",
    "editor.foreground": "#EBDBB2",
    "editor.selectionBackground": "#504945",
    "editor.lineHighlightBackground": "#3C3836",
    "editorIndentGuide.activeBackground": "#665C54"
  },
  "tokenColors": [
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#FB4934"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#B8BB26"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "foreground": "#83A598"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#FE8019"
      }
    },
    {
      "name": "Markup Heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#FABD2F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#FE8019",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#83A598",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Link",
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#83A598"
      }
    },
    {
      "name": "Entity Name",
      "scope": "entity.name",
      "settings": {
        "foreground": "#FABD2F"
      }
    },
    {
      "name": "String Quoted",
      "scope": "string.quoted",
      "settings": {
        "foreground": "#B8BB26"
      }
    }
  ]
}
