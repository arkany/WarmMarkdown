{
  "name": "One Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#282C34",
    "editor.foreground": "#ABB2BF",
    "editor.selectionBackground": "#3E4451",
    "editor.lineHighlightBackground": "#2C313A",
    "editorIndentGuide.activeBackground": "#4B5263"
  },
  "tokenColors": [
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#5C6370",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Markup Heading",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Link",
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "Entity Name",
      "scope": "entity.name",
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "String Quoted",
      "scope": "string.quoted",
      "settings": {
        "foreground": "#98C379"
      }
    }
  ]
}
